# Vorlage für die Konfiguration.
# Kopiere diese Datei zu .env.local und trage deine echten Werte ein.
# .env.local wird NIE in Git eingecheckt und darf niemandem geschickt werden.

# ---------------------------------------------------------------------------
# Datenquelle
# ---------------------------------------------------------------------------
# lokal    = JSON-Dateien auf deinem Mac, kein Konto nötig (Phase 1)
# supabase = echtes Supabase-Projekt (sobald du eines angelegt hast)
DATENQUELLE=lokal

# ---------------------------------------------------------------------------
# Sitzungs-Geheimnis (Pflicht)
# ---------------------------------------------------------------------------
# Zufallszeichenkette, mit der Anmelde-Cookies signiert werden.
# Neu erzeugen mit:  openssl rand -base64 48
SITZUNGS_GEHEIMNIS=

# ---------------------------------------------------------------------------
# Umsatzsteuer
# ---------------------------------------------------------------------------
# kleinunternehmer = keine USt ausweisen, Hinweis nach § 19 UStG auf Rechnungen
# regel            = USt mit dem Satz aus UST_SATZ ausweisen
#
# Festgelegt am 04.08.2026: kleinunternehmer.
# Grenzen seit der Reform 2025: 25.000 € Vorjahresumsatz und 100.000 € im
# laufenden Jahr. Die 100.000 € wirken SOFORT — wird die Grenze mitten im Jahr
# überschritten, ist der auslösende Umsatz bereits steuerpflichtig. Maßgeblich
# ist allein die Provision, nicht das Verkaufsvolumen der Verkäufer.
UST_MODUS=kleinunternehmer
UST_SATZ=19

# ---------------------------------------------------------------------------
# Supabase (erst nötig, wenn DATENQUELLE=supabase)
# ---------------------------------------------------------------------------
# Zu finden im Supabase-Projekt unter: Project Settings -> API
# NEXT_PUBLIC_ heißt: dieser Wert ist im Browser sichtbar. Das ist beim
# anon-Key so gewollt und ungefährlich, weil Row Level Security ihn absichert.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ACHTUNG: Der service_role-Key hebelt Row Level Security komplett aus.
# Er darf NIEMALS mit NEXT_PUBLIC_ beginnen und nur serverseitig verwendet werden.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Ab Phase 2 (jetzt noch nicht nötig, leer lassen)
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
RESEND_API_KEY=

# Adresse, unter der die Seite laeuft. Ziel fuer Links aus Supabase-Mails.
# Beim Deployment auf die echte Domain aendern.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Duerfen Suchmaschinen die Seite aufnehmen? Nur der Wert "erlaubt" oeffnet
# sie. Alles andere (auch ein fehlender Eintrag) erzeugt eine robots.txt mit
# vollstaendigem Verbot und ein noindex auf jeder Seite. Erst umstellen, wenn
# der Marktplatz wirklich live gehen soll -- ein einmal aufgenommener
# Entwurfsstand bleibt wochenlang in den Suchergebnissen.
SUCHMASCHINEN=gesperrt

# Absenderadresse fuer Mails. Ohne eigene verifizierte Domain funktioniert
# nur onboarding@resend.dev, und dann nur an die eigene Kontoadresse.
# Beim Livegang auf shop@deine-domain.de aendern.
MAIL_ABSENDER=Digitalmarkt <onboarding@resend.dev>

# ---------------------------------------------------------------------------
# Admin-Bereich (/admin)
# ---------------------------------------------------------------------------
# Kommagetrennte Liste der E-Mail-Adressen, die den Betreiber-Bereich sehen
# duerfen. Die Adresse muss zu einem angemeldeten Konto gehoeren.
#
# Ist der Wert leer, ist /admin fuer NIEMANDEN erreichbar. Das ist Absicht:
# ein vergessener Eintrag darf den Bereich nicht fuer jeden Angemeldeten
# oeffnen. Der Bereich sieht die Daten ALLER Verkaeufer.
ADMIN_EMAILS=
